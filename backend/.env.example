# Kelana Backend Proxy Environment Configuration

PORT=5000
NODE_ENV=development

# Gemini API Key (dapatkan dari https://aistudio.google.com/)
GEMINI_API_KEY=

# Google Maps Platform API Key (Places API & Directions API)
# Dapat menggunakan satu API key yang mengaktifkan Places API (New) & Directions API
GOOGLE_PLACES_API_KEY=
GOOGLE_DIRECTIONS_API_KEY=

# Fallback mode: "auto" (default, jika API key kosong pakai mock data cerdas)
# atau "always" (selalu mock data untuk demo cepat)
# atau "never" (wajib panggil Google API asli)
MOCK_MODE=auto
